  justify-content: space-between;
  gap: 16px;
  margin-bottom: calc(32.4 * var(--u));
}

.k-head__title {
  margin: 0;
  font-family: var(--x-font-display);
  font-weight: 600;
  font-size: calc(48.563 * var(--u));
  line-height: 1;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: var(--k-ink);
}

/* Кнопка «Профіль» */
.k-profile {
  display: inline-flex;
  align-items: center;
  gap: calc(10.792 * var(--u));
  height: calc(60.275 * var(--u));   /* у Figma обведення всередині рамки */
  padding: 0 calc(21.583 * var(--u));
  border: calc(1.349 * var(--u)) solid var(--k-border);
  border-radius: 999px;
  background: #fff;
  filter: drop-shadow(0 calc(5.396 * var(--u)) calc(8.094 * var(--u)) rgba(0, 0, 0, .07));
  color: var(--k-ink);
  font-family: var(--x-font-text);
  font-weight: 600;
  font-size: calc(18.885 * var(--u));
  line-height: normal;
  white-space: nowrap;
  transition: border-color var(--x-ease), color var(--x-ease);
}
.k-profile img { width: calc(38.692 * var(--u)); height: calc(38.692 * var(--u)); }
.k-profile:hover { border-color: var(--k-accent); color: var(--k-accent); }

/* Сітка: 540.93 / 505.86 / 450.55, проміжок 28.328 */
.k-grid {
  display: grid;
  grid-template-columns: 540.93fr 505.86fr 450.55fr;
  gap: calc(28.328 * var(--u));
  align-items: stretch;
}

.k-col {
  display: flex;
  flex-direction: column;
  gap: calc(26.979 * var(--u));
  min-width: 0;
}

/* ---------------------------------------------------------------------------
   4. КАРТКИ
   --------------------------------------------------------------------------- */
.k-card {
  position: relative;
  box-sizing: border-box;
  padding: var(--k-card-pad);
  border: calc(1.349 * var(--u)) solid var(--k-border);
  border-radius: var(--k-radius);
  background: #fff;
  box-shadow: 0 calc(5.396 * var(--u)) calc(16.188 * var(--u)) rgba(0, 0, 0, .04);
}

/* Велика картка — 350.73, вміст розкладений space-between */
.k-card--big {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: calc(350.729 * var(--u));
  overflow: hidden;
}

.k-card__label {
  margin: 0;
  font-weight: 600;
  font-size: calc(18.885 * var(--u));
  line-height: normal;
  color: var(--k-muted);
  /* не заїжджати під квадрат з іконкою */
  padding-right: calc(110 * var(--u));
}

.k-card__value {
  display: flex;
  align-items: baseline;
  gap: calc(14.334 * var(--u));
  margin: 0;
  text-transform: uppercase;
  white-space: nowrap;
}
.k-card__num {
  font-family: var(--x-font-display);
  font-weight: 700;
  font-size: calc(64.5 * var(--u));
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--k-ink);
}
.k-card__unit {
  font-weight: 700;
  font-size: calc(21.501 * var(--u));
  line-height: normal;
  color: var(--k-muted);
}

.k-card__foot {
  display: flex;
  flex-direction: column;
  gap: calc(16.188 * var(--u));
}
.k-card__note {
  margin: 0;
  font-weight: 700;
  font-size: calc(17.536 * var(--u));
  line-height: normal;
  color: var(--k-ink);
}
.k-card__note--muted { color: var(--k-muted); }

/* Квадрат з іконкою в правому верхньому куті — 134.9, заходить за край на 1.35.
   Активна плашка: квадрат червоний, іконка біла (як «Баланс» у макеті).
   Неактивна: квадрат білий, іконка червона (як «Телебачення»).
   Червоний шар «напливає» з правого верхнього кута по колу — clip-path. */
.k-card__badge {
  position: absolute;
  top: calc(-0.92 * var(--u));
  right: calc(-1.35 * var(--u));
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(134.896 * var(--u));
  height: calc(134.896 * var(--u));
  padding: 0;
  border: 0;
  border-radius: var(--k-radius);
  background: #fff;
  color: var(--x-red);
  pointer-events: none;        /* реагує вся плашка, квадрат — лише декор */
  isolation: isolate;          /* щоб червоний шар ліг під іконку, а не під картку */
  transition: color .35s ease .1s;
}
.k-card__badge::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  background: var(--k-accent);
  clip-path: circle(0% at 100% 0%);
  transition: clip-path .55s cubic-bezier(.65, 0, .35, 1);
}
.k-card.is-active .k-card__badge { color: #fff; }
.k-card.is-active .k-card__badge::before { clip-path: circle(142% at 100% 0%); }

/* Іконка — SVG з Figma, вставлений у HTML зі stroke="currentColor",
   тому вона бере колір квадрата (color) і плавно перефарбовується */
.k-card__icon {
  display: block;
  width: calc(51.26 * var(--u));
  height: calc(51.26 * var(--u));
  transition: transform .55s cubic-bezier(.65, 0, .35, 1);
}
.k-card.is-active .k-card__icon { transform: scale(1.04); }
/* у макеті wifi піднятий на 2.7 всередині рамки 51.26 */
.k-card__icon--wifi { margin-top: calc(-5.4 * var(--u)); }


@media (prefers-reduced-motion: reduce) {
  .k-card__badge, .k-card__badge::before, .k-card__icon { transition: none; }
}

/* Кнопка картки — 64.75, radius 10.79 */
.k-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: calc(64.75 * var(--u));
  padding: 0 16px;
  border: 0;
  border-radius: var(--k-radius);
  background: var(--k-accent);
  color: #fff;
  font-family: var(--x-font-text);
  font-weight: 700;
  font-size: calc(18.885 * var(--u));
  line-height: normal;
  cursor: pointer;
  transition: background-color var(--x-ease);
}
.k-btn:hover { background: var(--k-accent-h); }
.k-btn:active { background: #6f0000; }

/* Мала картка статусу — 129.5 */
.k-card--status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: calc(129.5 * var(--u));
  box-shadow: none;
  filter: drop-shadow(0 calc(5.396 * var(--u)) calc(8.094 * var(--u)) rgba(0, 0, 0, .04));
}
.k-status {
  display: flex;
  flex-direction: column;
  gap: calc(5.396 * var(--u));
  min-width: 0;
}
.k-status__label {
  margin: 0;
  font-weight: 600;
  font-size: calc(17.536 * var(--u));
  line-height: normal;
  color: var(--k-muted);
}
.k-status__value {
  margin: 0;
  font-weight: 700;
  font-size: calc(29.677 * var(--u));
  line-height: normal;
  color: var(--k-ink);
  text-transform: uppercase;
}
.k-card--status > img { width: calc(37.771 * var(--u)); height: calc(37.771 * var(--u)); flex: none; }

/* ---------------------------------------------------------------------------
   5. КАРТКА ТАРИФУ   tariff-info-card 2211:1621 — 450.55 × 507.21
   --------------------------------------------------------------------------- */
.k-tariff {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: calc(14.784 * var(--u));
  box-sizing: border-box;
  height: 100%;
  min-height: calc(507.208 * var(--u));
  padding: calc(8.094 * var(--u)) calc(22.176 * var(--u));
  border: 0.462px solid rgba(0, 0, 0, .1);
  border-radius: calc(5.544 * var(--u));
  background: #fff;
  filter: drop-shadow(0 0 2.863px rgba(0, 0, 0, .02)) drop-shadow(1.909px 1.909px 1.909px rgba(0, 0, 0, .08));
}
.k-tariff > * { width: 100%; }

.k-tariff__top {
  display: flex;
  align-items: center;
  gap: calc(9.859 * var(--u));
}
.k-tariff__top img { width: calc(19.709 * var(--u)); height: calc(19.709 * var(--u)); }

.k-tariff__kicker,
.k-tariff__more {
  margin: 0;
  font-family: var(--x-font-display);
  font-weight: 500;
  font-size: calc(12.936 * var(--u));
  line-height: normal;
  text-transform: uppercase;
  color: var(--x-ink-muted);
}

.k-tariff__rule {
  height: calc(1.229 * var(--u));
  min-height: 1px;
  background: rgba(0, 0, 0, .1);
}

.k-tariff__name {
  margin: 0;
  font-family: var(--x-font-display);
  font-weight: 700;
  font-size: calc(43.167 * var(--u));
  line-height: 1;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: var(--x-ink);
}

/* Ілюстрація 265.74 × 218.53 і підпис швидкості поверх неї */
.k-tariff__art {
  position: relative;
  width: calc(272.55 * var(--u));
  height: calc(218.531 * var(--u));
  align-self: center;
}
.k-tariff__art img {
  width: calc(265.745 * var(--u));
  height: calc(218.531 * var(--u));
  object-fit: contain;
}
.k-tariff__speed {
  position: absolute;
  left: calc(187.8 * var(--u));
  top: calc(30.78 * var(--u));
  width: calc(84.752 * var(--u));
  margin: 0;
  font-family: var(--x-font-display);
  font-weight: 600;
  font-size: calc(40.469 * var(--u));
  line-height: 0.9;
  letter-spacing: -0.02em;
  text-align: center;
  color: var(--x-red);
}
.k-tariff__speed span { display: block; }

.k-tariff__price {
  margin: 0;
  font-family: var(--x-font-display);
  font-weight: 700;
  font-size: calc(29.677 * var(--u));
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--x-red);
  white-space: nowrap;
}

.k-tariff__next {
  margin: 0;
  font-weight: 500;
  font-size: calc(16.632 * var(--u));
  line-height: 1.1;
  color: var(--x-ink-muted);
}

/* «Можливості тарифу» — розгортається список */
.k-tariff__toggle {
  display: inline-flex;
  align-items: center;
  gap: calc(7.392 * var(--u));
  width: auto;
  align-self: flex-start;
  padding: 0;
  border: 0;
  background: none;
  cursor: pointer;
}
.k-tariff__more { color: var(--x-red); }
.k-tariff__toggle img {
  width: calc(11.1 * var(--u));
  height: calc(7.4 * var(--u));
  transition: transform var(--x-ease);
}
/* У макеті стрілка дивиться вгору (закритий стан); відкрили — перевертаємо */
.k-tariff__toggle[aria-expanded="true"] img { transform: rotate(180deg); }
.k-tariff__toggle:hover .k-tariff__more { text-decoration: underline; text-underline-offset: 3px; }

.k-tariff__features {
  margin: 0;
  padding: 0 0 0 1.1em;
  font-size: calc(16 * var(--u));
