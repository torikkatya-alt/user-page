   після того, як ви домалювали розмітку через JS.
   ========================================================================== */
(function (window, document) {
  'use strict';

  /* ------------------------------------------------------------------
     Дрібні хелпери
     ------------------------------------------------------------------ */
  var $  = function (sel, root) { return (root || document).querySelector(sel); };
  var $$ = function (sel, root) {
    return Array.prototype.slice.call((root || document).querySelectorAll(sel));
  };

  /* ==================================================================
     1. ХЕДЕР — підложка над світлим фоном
     ------------------------------------------------------------------
     Як це працює.
     Хедер прозорий, поки під ним темна секція (hero, фото, червоний блок).
     Щойно під шапкою виявляється світла секція — вішаємо data-solid="true".

     Що потрібно від розмітки: кожній секції, над якою шапка має бути
     з підложкою, поставте data-header="light". Наприклад:

         <section class="hero">…</section>                <!-- темна, нічого не треба -->
         <section data-header="light">…</section>         <!-- світла -->
         <footer class="x-footer">…</footer>              <!-- червона, темна -->

     Якщо жодної секції з data-header не знайдено, працює простий запас:
     підложка з'являється після того, як сторінку прокрутили нижче висоти
     першого екрана (або нижче 80px, якщо hero немає).
     ================================================================== */
  function initHeaderScrim() {
    var header = $('.x-header:not(.x-header--static)');
    if (!header) return;

    var light = $$('[data-header="light"]');
    var probeOffset = header.offsetHeight * 0.5;   // дивимось на середину шапки
    var raf = null;

    function apply(state) {
      var next = state ? 'true' : 'false';
      if (header.getAttribute('data-solid') !== next) {
        header.setAttribute('data-solid', next);
      }
    }

    function measure() {
      raf = null;

      if (light.length) {
        // Чи перетинає середина шапки якусь світлу секцію
        var y = probeOffset;
        for (var i = 0; i < light.length; i++) {
          var r = light[i].getBoundingClientRect();
          if (r.top <= y && r.bottom >= y) { apply(true); return; }
        }
        apply(false);
        return;
      }

      // запас: без розмітки — по величині прокрутки
      var hero = $('[data-hero], .hero, .x-hero');
      var limit = hero ? hero.offsetHeight - header.offsetHeight : 80;
      apply(window.pageYOffset > limit);
    }

    function onScroll() {
      if (raf === null) raf = window.requestAnimationFrame(measure);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    measure();
  }

  /* ==================================================================
     2. МОБІЛЬНЕ МЕНЮ
     Розмітка: .x-mheader з кнопкою .x-mheader__toggle,
               панель .x-mmenu (id вказується в aria-controls кнопки).
     ================================================================== */
  function initMobileMenu() {
    var bar = $('.x-mheader');
    if (!bar || bar.dataset.xInit === 'menu') return;

    var toggle = $('.x-mheader__toggle', bar);
    if (!toggle) return;

    var panelId = toggle.getAttribute('aria-controls');
    var panel   = panelId ? document.getElementById(panelId) : $('.x-mmenu');
    if (!panel) return;

    bar.dataset.xInit = 'menu';

    // silent = не переносити фокус (потрібно при першій ініціалізації,
    // інакше кнопка «[меню]» отримує фокус-рамку відразу після завантаження)
    function setOpen(open, silent) {
      bar.classList.toggle('is-open', open);
      panel.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.documentElement.classList.toggle('x-no-scroll', open);

      if (silent) return;

      if (open) {
        var first = $('a, button', panel);
        if (first) first.focus({ preventScroll: true });
      } else {
        toggle.focus({ preventScroll: true });
      }
    }

    toggle.addEventListener('click', function () {
      setOpen(!bar.classList.contains('is-open'));
    });

    // клік по пункту меню — закриваємо (щоб працювали й якорі на тій самій сторінці)
    panel.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && bar.classList.contains('is-open')) setOpen(false);
    });

    // якщо перейшли на десктопну ширину з відкритим меню — прибираємо
    window.addEventListener('resize', function () {
      if (window.innerWidth > 1024 && bar.classList.contains('is-open')) setOpen(false, true);
    });

    setOpen(false, true);
  }

  /* ==================================================================
     3. ПОПАП ТЕЛЕФОНІВ
     Розмітка: .x-phone > button.x-phone__fab + .x-phone__pop
     Номери всередині — звичайні <a href="tel:…">, тому на телефоні
     тап по номеру відкриває набір у самому апараті.
     ================================================================== */
  function initPhonePopovers() {
    var widgets = $$('.x-phone');
    if (!widgets.length) return;

    function close(widget) {
      widget.classList.remove('is-open');
      var btn = $('.x-phone__fab', widget);
      if (btn) btn.setAttribute('aria-expanded', 'false');
    }

    widgets.forEach(function (widget) {
      if (widget.dataset.xInit === 'phone') return;
      widget.dataset.xInit = 'phone';

      var btn = $('.x-phone__fab', widget);
      if (!btn) return;

      btn.setAttribute('aria-expanded', 'false');

      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = !widget.classList.contains('is-open');
        widgets.forEach(close);
        widget.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.x-phone')) widgets.forEach(close);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') widgets.forEach(close);
    });
  }

  /* ==================================================================
     Публічний API
     ================================================================== */
  var XbyteUI = {
    init: function () {
      initHeaderScrim();
      initMobileMenu();
      initPhonePopovers();
    }
  };

  window.XbyteUI = XbyteUI;

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', XbyteUI.init);
  } else {
    XbyteUI.init();
  }
})(window, document);

</script>
<script>
/* ==========================================================================
   XBYTE — Особистий кабінет, головна
   Логіка сторінки: плашки з квадратами, попапи «Профіль» і «Поповнення»,
   «Можливості тарифу», кнопка телефонів. Жодних запитів до бази тут немає —
   дані підставляє бекенд у data-field, а дії йдуть подіями xbyte:* на document.
   ========================================================================== */
(function () {
  'use strict';

  var $  = function (s, root) { return (root || document).querySelector(s); };
  var $$ = function (s, root) { return Array.prototype.slice.call((root || document).querySelectorAll(s)); };

  function emit(name, detail) {
    document.dispatchEvent(new CustomEvent('xbyte:' + name, { detail: detail || {} }));
  }

  /* ------------------------------------------------------------------------
     «Можливості тарифу» — показати / сховати список
     ------------------------------------------------------------------------ */
  var toggle = $('.k-tariff__toggle');
  if (toggle) {
    var list = document.getElementById(toggle.getAttribute('aria-controls'));
    toggle.addEventListener('click', function () {
      var open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      if (list) list.hidden = !open;
    });
  }

  /* Кнопка «Мій номер» у верхній панелі — меню в макеті немає, лише подія */
  var user = $('[data-k-user]');
  if (user) {
    user.addEventListener('click', function () {
      var open = user.getAttribute('aria-expanded') !== 'true';
      user.setAttribute('aria-expanded', String(open));
      emit('user-menu', { open: open });
    });
  }

  /* Кнопки з data-k-action → подія xbyte:<назва> (top-up, order-tv, logout…) */
  $$('[data-k-action]').forEach(function (btn) {
    btn.addEventListener('click', function () { emit(btn.dataset.kAction); });
  });

  /* ------------------------------------------------------------------------
     Плашки «Баланс» / «Телебачення»
     Мишка над плашкою → її квадрат наливається червоним, у другої білішає.
     Мишка пішла → повертається стартовий стан (активна та, що з is-active
     в HTML, тобто «Баланс», як у макеті).
     На телефоні наведення немає, тож там працює тап.
     Клавіатура: фокус на кнопці плашки теж робить її активною.
     Подія xbyte:card-active { card: 'balance' | 'tv' } — при кожній зміні.
     ------------------------------------------------------------------------ */
  var cards = $$('.k-card--switch');
  var initial = cards.filter(function (c) { return c.classList.contains('is-active'); })[0] || cards[0];

  function activate(card) {
    if (!card || card.classList.contains('is-active')) return;
    cards.forEach(function (c) { c.classList.toggle('is-active', c === card); });
    emit('card-active', { card: card.dataset.kCard });
  }

  cards.forEach(function (card) {
    card.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') activate(card); });
    card.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') activate(initial); });
    card.addEventListener('pointerdown',  function (e) { if (e.pointerType !== 'mouse') activate(card); });
    card.addEventListener('focusin',  function () { activate(card); });
    card.addEventListener('focusout', function (e) { if (!card.contains(e.relatedTarget)) activate(initial); });
  });

  /* ------------------------------------------------------------------------
     Попапи (нативний <dialog>)
     Відкрити: будь-яка кнопка з data-k-open="<id діалогу>".
     Закрити: хрестик (data-k-close), Esc, клік по затемненню.
     Перемкнути вид усередині: data-k-view="menu" / "details".
     Відкрити з коду: XbyteKabinet.open('k-sheet-topup'), XbyteKabinet.close().
     ------------------------------------------------------------------------ */
  var CLOSE_MS = 420;
  var opener = null;

  function showView(dialog, name, dir) {
    var views = $$('.k-sheet__view[data-view]', dialog);
    if (!views.length) return;
    views.forEach(function (v) {
      var on = v.dataset.view === name;
      v.hidden = !on;
      v.classList.remove('is-in-fwd', 'is-in-back');
      if (on && dir) {
        void v.offsetWidth;                         // перезапуск анімації
        v.classList.add(dir === 'back' ? 'is-in-back' : 'is-in-fwd');
      }
    });
    var target = views.filter(function (v) { return !v.hidden; })[0];
    var first = target && $('[data-k-view], .k-menu__item, [data-k-close]', target);
    if (first && dir) first.focus();
    emit('sheet-view', { sheet: dialog.id, view: name });
  }

  function openSheet(id, from) {
    var dialog = document.getElementById(id);
    if (!dialog || dialog.open) return;
    opener = from || document.activeElement;
    var firstView = $('.k-sheet__view[data-view]', dialog);
    if (firstView) showView(dialog, firstView.dataset.view);
    dialog.showModal();
    document.documentElement.classList.add('k-lock');
    requestAnimationFrame(function () { dialog.classList.add('is-visible'); });
    if (id === 'k-sheet-topup') resetPay();
    emit('sheet-open', { sheet: id });
  }

  function closeSheet(dialog) {
    if (!dialog || !dialog.open || dialog.dataset.closing) return;
    dialog.dataset.closing = '1';
    dialog.classList.remove('is-visible');
    setTimeout(function () {
      dialog.close();
      delete dialog.dataset.closing;
      document.documentElement.classList.remove('k-lock');
      if (opener && opener.focus) opener.focus();
      emit('sheet-close', { sheet: dialog.id });
    }, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : CLOSE_MS);
  }

  $$('[data-k-open]').forEach(function (btn) {
    btn.addEventListener('click', function () { openSheet(btn.dataset.kOpen, btn); });
  });

  $$('.k-sheet').forEach(function (dialog) {
    // Esc — закриваємо з анімацією, а не миттєво
    dialog.addEventListener('cancel', function (e) { e.preventDefault(); closeSheet(dialog); });

    dialog.addEventListener('click', function (e) {
      if (e.target.closest('[data-k-close]')) { closeSheet(dialog); return; }

      var viewBtn = e.target.closest('[data-k-view]');
      if (viewBtn) {
        var back = viewBtn.classList.contains('k-sheet__icon-btn--back');
        showView(dialog, viewBtn.dataset.kView, back ? 'back' : 'fwd');
        return;
      }

      // клік по затемненню: точка поза прямокутником панелі
      if (e.target === dialog) {
        var r = dialog.getBoundingClientRect();
        var inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
        if (!inside) closeSheet(dialog);
      }
    });
  });

  /* ------------------------------------------------------------------------
     Поповнення
     - у поле суми можна ввести тільки цифри, до 6 знаків
     - кнопка оплати міняє іконку і напис під обраний спосіб
     - «оплатити» з порожньою сумою → підсвічує поле; інакше
       подія xbyte:pay { amount, method, phone } і панель закривається
     ------------------------------------------------------------------------ */
  var payForm = $('[data-k-pay]');
  var amountBox, amountInput, amountHint, payIcon, payText, appleIcon;
  // напис на кнопці під кожен спосіб; іконка береться з рядка способу,
  // для Apple Pay — окрема з макета (вона стоїть у кнопці з самого початку)
  var PAY_TEXT = { 'apple-pay': 'Pay', 'google-pay': 'Pay', 'card': 'Оплатити' };

  function fitAmount() {
    // запасний варіант для браузерів без field-sizing: ширина = кількість цифр
    if (window.CSS && CSS.supports && CSS.supports('field-sizing', 'content')) return;
    var len = Math.max(1, (amountInput.value || amountInput.placeholder).length);
    amountInput.style.width = (len * 0.72 + 0.1) + 'em';
  }

  function setError(on) {
    amountBox.classList.toggle('is-error', on);
    amountHint.textContent = on ? 'Введіть суму поповнення' : amountHint.dataset.hint;
    amountInput.setAttribute('aria-invalid', String(on));
  }

  function resetPay() {
    if (!payForm) return;
    payForm.reset();
    setError(false);
    fitAmount();
    updateMethod();
  }

  function updateMethod() {
    var checked = $('input[name="method"]:checked', payForm);
    var value = checked ? checked.value : 'apple-pay';
    // іконка кнопки: для Apple Pay — своя з макета, для інших — копія з рядка способу
    var rowIcon = checked && $('.k-method__icon', checked.closest('.k-method'));
    var icon = (value === 'apple-pay' || !rowIcon) ? appleIcon.cloneNode(true) : rowIcon.cloneNode(true);
    icon.setAttribute('class', 'k-pay__btn-icon');
    payIcon.replaceWith(icon);
    payIcon = icon;
    payText.textContent = PAY_TEXT[value] || 'Pay';
  }

  if (payForm) {
    amountBox   = $('.k-amount', payForm);
    amountInput = $('.k-amount__input', payForm);
    amountHint  = $('.k-amount__hint', payForm);
    payIcon     = $('.k-pay__btn-icon', payForm);
    payText     = $('.k-pay__btn-text', payForm);
    appleIcon   = payIcon.cloneNode(true);

    amountInput.addEventListener('input', function () {
      var clean = amountInput.value.replace(/\D+/g, '').replace(/^0+(?=\d)/, '').slice(0, 6);
      if (clean !== amountInput.value) amountInput.value = clean;
      if (clean) setError(false);
      fitAmount();
    });

    $$('input[name="method"]', payForm).forEach(function (r) {
      r.addEventListener('change', function () {
        updateMethod();
        emit('pay-method', { method: r.value });
      });
    });

    payForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var amount = parseInt(amountInput.value, 10) || 0;
      if (amount <= 0) {
        setError(true);
        amountInput.focus();
        return;
      }
      var method = $('input[name="method"]:checked', payForm).value;
      var phoneEl = $('[data-field="phone"]', payForm);
      emit('pay', { amount: amount, method: method, phone: phoneEl ? phoneEl.textContent.trim() : '' });
      closeSheet(payForm.closest('dialog'));
    });

    fitAmount();
  }

  window.XbyteKabinet = {
    open: function (id) { openSheet(id); },
    close: function () { $$('.k-sheet').forEach(closeSheet); }
  };

  /* ------------------------------------------------------------------------
     Кнопка телефонів зупиняється за 45px над футером (як у макеті)
     ------------------------------------------------------------------------ */
  var fab = $('.x-phone--fixed');
  var footer = $('.x-footer');
  if (fab && footer) {
    var GAP = 45, MIN = matchMedia('(max-width: 720px)').matches ? 16 : 32;
    var place = function () {
      var lift = window.innerHeight - footer.getBoundingClientRect().top + GAP;
      fab.style.setProperty('--k-fab-bottom', Math.max(MIN, lift) + 'px');
    };
    place();
    window.addEventListener('scroll', place, { passive: true });
    window.addEventListener('resize', function () {
      MIN = matchMedia('(max-width: 720px)').matches ? 16 : 32;
      place();
    });
  }

  /* Якщо ілюстрацію тарифу прибрали з assets — не показувати «биту» картинку */
  var art = $('.k-tariff__art img');
  if (art) {
    art.addEventListener('error', function () { art.style.visibility = 'hidden'; });
    if (art.complete && art.naturalWidth === 0) art.style.visibility = 'hidden';
  }
})();

</script>
</body>
</html>
