  border-bottom: 1px solid var(--k-bar-line);
}

.k-bar__inner {
  max-width: 1920px;
  height: 84px;           /* + 1px лінія = 85, як у макеті */
  margin: 0 auto;
  padding: 0 32px 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.k-bar__logo img { width: 96px; height: 28px; }

/* Кнопка «Мій номер» — пігулка */
.k-user {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 6px 12px 6px 6px;
  border: 1px solid rgba(255, 255, 255, .08);
  border-radius: 100px;
  background: rgba(255, 255, 255, .03);
  color: var(--k-nav-text);
  font-family: var(--x-font-text);
  font-size: 14px;
  line-height: normal;
  cursor: pointer;
  transition: background-color var(--x-ease), border-color var(--x-ease);
}
.k-user:hover { background: rgba(255, 255, 255, .08); border-color: rgba(255, 255, 255, .16); }

.k-user__avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 16px;
  background: var(--x-blue);
  flex: none;
}
.k-user__avatar img { width: 18px; height: 18px; }
.k-user__label { font-weight: 500; }
.k-user__num   { font-weight: 700; white-space: nowrap; }
.k-user__chev  { width: 16px; height: 16px; transition: transform var(--x-ease); }
.k-user[aria-expanded="true"] .k-user__chev { transform: rotate(180deg); }

/* ---------------------------------------------------------------------------
   2. ВКЛАДКИ   sidebar 2184:1216 — 88px, ряд 1559 по центру
   Активна вкладка світла і на 5px «висить» нижче панелі — зливається з фоном
   сторінки, як вкладка папки.
   --------------------------------------------------------------------------- */
.k-tabs {
  background: var(--k-bar-grad);
  height: calc(88 * var(--u));
  padding-top: calc(32 * var(--u));
  box-sizing: border-box;
}

.k-tabs__list {
  display: flex;
  align-items: flex-start;
  gap: calc(5.333 * var(--u));
  width: min(calc(1559 * var(--u)), 100% - 2 * var(--k-gutter));
  margin: 0 auto;
  padding: 0;
  list-style: none;
}

.k-tabs__list > li { flex: 1 1 0; min-width: 0; }
.k-tabs__list > li:first-child { flex: 0 0 calc(236 * var(--u)); }

.k-tab {
  display: flex;
  align-items: center;
  gap: calc(21.333 * var(--u));
  height: calc(56 * var(--u));
  padding: 0 calc(32 * var(--u));
  box-sizing: border-box;
  background: var(--k-nav);
  color: var(--k-nav-text);
  font-family: var(--x-font-text);
  font-size: calc(18.667 * var(--u));
  line-height: normal;
  white-space: nowrap;
  transition: background-color var(--x-ease), color var(--x-ease);
}
.k-tab img { width: calc(24 * var(--u)); height: calc(24 * var(--u)); flex: none; }
.k-tab:hover { background: #313f82; }

.k-tab[aria-current="page"] {
  position: relative;
  height: calc(61 * var(--u));
  border-radius: 6px 6px 0 0;
  background: var(--k-page);
  color: var(--x-red);
  font-family: var(--x-font-display);
  font-weight: 600;
  text-transform: uppercase;
}

/* ---------------------------------------------------------------------------
   3. ТІЛО   body 2184:1215 — контент 1554, відступ зверху 103, знизу ~142
   --------------------------------------------------------------------------- */
.k-main {
  width: min(calc(1554 * var(--u)), 100% - 2 * var(--k-gutter));
  margin: 0 auto;
  padding: calc(103 * var(--u)) 0 calc(142 * var(--u));
