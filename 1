  color: var(--x-ink-muted);
}
.k-tariff__features[hidden] { display: none; }

/* ---------------------------------------------------------------------------
   6. АДАПТИВ
   --------------------------------------------------------------------------- */

/* Мінімальні кеглі, щоб на 0.8px-масштабі текст не ставав дрібним */
@media (max-width: 1536px) {
  .k-tab { font-size: max(calc(18.667 * var(--u)), 15px); }
}

/* Планшет: дві колонки, картка тарифу — на всю ширину під ними */
@media (max-width: 1180px) {
  :root { --u: 0.85px; }

  .k-tabs { height: auto; padding-top: 20px; }
  .k-tabs__list {
    width: auto;
    margin: 0;
    padding: 0 var(--k-gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .k-tabs__list::-webkit-scrollbar { display: none; }
  .k-tabs__list > li,
  .k-tabs__list > li:first-child { flex: 0 0 auto; }
  .k-tab { font-size: 16px; gap: 12px; padding: 0 20px; }

  .k-grid { grid-template-columns: 1fr 1fr; }
  .k-col--tariff { grid-column: 1 / -1; }
  .k-tariff { min-height: 0; padding-top: 20px; padding-bottom: 20px; }
}

/* Телефон: усе в один стовпчик */
@media (max-width: 720px) {
  :root { --u: 0.8px; --k-gutter: 16px; }

  .k-bar__inner { height: 64px; padding: 0 var(--k-gutter); }
  .k-user { gap: 8px; }
  .k-user__label { display: none; }

  .k-tab { height: 48px; font-size: 15px; }
  .k-tab[aria-current="page"] { height: 52px; }

  .k-main { padding: 32px 0 120px; }
  .k-head { margin-bottom: 20px; }
  .k-head__title { font-size: 30px; }
  .k-profile { font-size: 15px; height: 44px; padding: 0 14px 0 8px; }
  .k-profile img { width: 30px; height: 30px; }

  .k-grid { grid-template-columns: 1fr; gap: 16px; }
  .k-col { gap: 16px; }
  .k-col--tariff { grid-column: auto; }

  .k-card--big { height: auto; min-height: 280px; gap: 28px; }
  .k-card__label { font-size: 16px; }
  .k-card__num { font-size: 48px; }
  .k-card__unit { font-size: 18px; }
  .k-card__note { font-size: 15px; }
  .k-card__badge { width: 96px; height: 96px; }
  .k-card__icon { width: 40px; height: 40px; }
  .k-card__icon--wifi { margin-top: -4px; }
  .k-btn { height: 56px; font-size: 16px; }

  .k-card--status { min-height: 96px; }
  .k-status__label { font-size: 15px; }
  .k-status__value { font-size: 22px; }

  .k-tariff__kicker, .k-tariff__more { font-size: 12px; }
  .k-tariff__name { font-size: 32px; }
  .k-tariff__price { font-size: 26px; }
  .k-tariff__next { font-size: 15px; }
  .k-tariff__features { font-size: 14px; }

  body.k-page .x-phone--fixed { right: 16px; }
  /* кнопку телефонів трохи менше, щоб не перекривала кнопки карток */
  .k-page .x-phone__fab { width: 64px; height: 64px; border-radius: 14px; }
  .k-page .x-phone__fab svg { width: 30px; height: 30px; }
}

/* ---------------------------------------------------------------------------
   7. КНОПКА ТЕЛЕФОНІВ на цій сторінці
   У макеті вона стоїть на 44px від правого краю і на 45px вище футера.
   Поки футер не видно — «висить» унизу вікна; коли футер під'їжджає,
   kabinet.js піднімає її, щоб не лягала на адресу.
   --------------------------------------------------------------------------- */
.k-page .x-phone--fixed { right: 44px; bottom: var(--k-fab-bottom, 32px); }

/* ===========================================================================
   8. ПОПАПИ (бокові панелі)
   Figma: 2169:3392 «Більше» · 2169:3663 «Деталі профілю» · 2169:3808 «Поповнення»
   Панель 640×941, 106px від верху і 32px від правого краю (канва 1920×1080),
   radius 37.65, градієнт 197° #111114 → #263269, під нею затемнення 12%.
   Зроблено на нативному <dialog>: браузер сам тримає фокус усередині,
   Esc закриває, решта сторінки недоступна, поки панель відкрита.
   =========================================================================== */
.k-sheet {
  --sheet-pad: calc(37.647 * var(--u));
  position: fixed;
  inset: calc(106 * var(--u)) calc(32 * var(--u)) auto auto;
  width: min(calc(640 * var(--u)), 100vw - 32px);
  height: min(calc(941 * var(--u)), 100dvh - calc(106 * var(--u)) - 24px);
  max-width: none;
  max-height: none;
  margin: 0;
  padding: 0;
  border: calc(1.882 * var(--u)) solid rgba(255, 255, 255, .1);
  border-radius: calc(37.647 * var(--u));
  background: linear-gradient(197.3deg, #111114 7.54%, #263269 90.91%);
  box-shadow: 0 calc(30.118 * var(--u)) calc(67.765 * var(--u)) rgba(0, 0, 0, .4);
  color: #fff;
  font-family: var(--x-font-text);
  overflow: hidden;
  /* поява: виїжджає справа */
  opacity: 0;
  transform: translateX(calc(48 * var(--u)));
  transition: opacity .32s ease, transform .42s cubic-bezier(.22, 1, .36, 1);
}
.k-sheet--narrow { right: calc(37 * var(--u)); width: min(calc(635 * var(--u)), 100vw - 32px); }
.k-sheet[open] { display: flex; flex-direction: column; }
.k-sheet.is-visible { opacity: 1; transform: none; }

html.k-lock { overflow: hidden; }   /* сторінка не прокручується під відкритою панеллю */

.k-sheet::backdrop {
  background: rgba(0, 0, 0, .12);
  opacity: 0;
  transition: opacity .32s ease;
}
.k-sheet.is-visible::backdrop { opacity: 1; }

/* Вид усередині панелі (меню / деталі) — кожен займає всю висоту */
.k-sheet__view {
  display: flex;
  flex-direction: column;
  min-height: 0;
  flex: 1 1 auto;
